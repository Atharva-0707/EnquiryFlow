    {
      "name": "4. Enquiries",
      "item": [
        {
          "name": "Get All Enquiries (With Search & Filter)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/enquiries?search=&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["enquiries"],
              "query": [
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Enquiry",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data._id) {",
                  "    pm.collectionVariables.set('enquiryId', response.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Aarav Patel\",\n  \"customerEmail\": \"aarav.patel@example.com\",\n  \"customerPhone\": \"+91 98765 43210\",\n  \"message\": \"Looking for a modern CRM integration for our multi-channel sales pipeline.\",\n  \"enquiryType\": \"Corporate\",\n  \"isConverted\": false,\n  \"feedback\": \"High intent lead\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enquiries",
              "host": ["{{baseUrl}}"],
              "path": ["enquiries"]
            }
          },
          "response": []
        },
        {
          "name": "Create Enquiry (Validation Failure)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"\",\n  \"customerEmail\": \"invalid-email\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enquiries",
              "host": ["{{baseUrl}}"],
              "path": ["enquiries"]
            },
            "description": "Expects 400 Bad Request with validation errors."
          },
          "response": []
        },
        {
          "name": "Get Single Enquiry",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/enquiries/{{enquiryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["enquiries", "{{enquiryId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Update Enquiry",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isConverted\": true,\n  \"feedback\": \"Contract signed and onboarding started!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enquiries/{{enquiryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["enquiries", "{{enquiryId}}"]
            }
          },
          "response": []
